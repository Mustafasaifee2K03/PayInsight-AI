# PayInsight AI configuration (all optional; defaults shown). Copy to .env to override.
# No API keys are required: the analysis engine is local and deterministic.

# Shared password for the three demo accounts (re-hashed automatically if changed)
PAYINSIGHT_DEMO_PASSWORD=PayInsight@2026

# Authentication. If JWT_SECRET is unset, a random secret is generated once into data/.jwt_secret.
# PAYINSIGHT_JWT_SECRET=<at least 32 random characters>
PAYINSIGHT_ACCESS_TOKEN_TTL_MINUTES=15
PAYINSIGHT_REFRESH_TOKEN_TTL_DAYS=7
# Set to true when served over HTTPS
PAYINSIGHT_REFRESH_COOKIE_SECURE=false
PAYINSIGHT_PASSWORD_HASH_ITERATIONS=600000
PAYINSIGHT_MAX_FAILED_LOGINS=5
PAYINSIGHT_LOCKOUT_MINUTES=15
PAYINSIGHT_AUTH_RATE_LIMIT_PER_MINUTE=30
PAYINSIGHT_ALLOW_SIGNUP=true
# Rate limiting backend (pluggable, see backend/app/core/ratelimit.py) and proxies whose X-Forwarded-For is trusted
PAYINSIGHT_RATE_LIMIT_BACKEND=memory
PAYINSIGHT_TRUSTED_PROXIES=127.0.0.1,::1
# app.db: FIFO in-process writer queue, audit retention, purge cadence
PAYINSIGHT_APP_DB_WRITE_GATE=true
PAYINSIGHT_AUDIT_RETENTION_DAYS=365
PAYINSIGHT_HOUSEKEEPING_INTERVAL_SECONDS=600

# Deterministic dataset (fixed historical window, never the machine clock)
PAYINSIGHT_DATA_START_DATE=2025-09-01
PAYINSIGHT_DATA_DAYS=60
PAYINSIGHT_DEFAULT_ROW_COUNT=30000
PAYINSIGHT_RANDOM_SEED=20250901

# SQL safety limits
PAYINSIGHT_QUERY_TIMEOUT_MS=3000
PAYINSIGHT_MAX_RESULT_ROWS=5000
# Process-wide SQLite heap ceiling in MB (0 disables it)
PAYINSIGHT_SQLITE_HEAP_LIMIT_MB=512

# Result cache
PAYINSIGHT_CACHE_MAX_ENTRIES=256
PAYINSIGHT_CACHE_TTL_SECONDS=600

PAYINSIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAYINSIGHT_LOG_LEVEL=INFO
